# 数据库文件
data/*.db
data/*.db-shm
data/*.db-wal
data/running/


# 日志
logs/
data/scheduler.log

# 本地定时兜底 / 数据源体检产物
data/.scheduler_state.json
# akshare 本地缓存 JSON（体积大且随时可重建，误提交会污染仓库）
data/akshare_cache/
# B1 图形库缓存（运行时生成，写不进去也不影响结果）
data/b1_pattern_library_cache.json
sources-health.json
# 每日档期对账产物，只走 artifact，不入库
docs/schedule-audit.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 临时文件
# 注意：不要忽略 test_*.py / tests/ —— 之前这条规则让测试文件根本提交不上来，
# 三个项目因此长期零测试。CI 门禁依赖 tests/ 目录入库。
*.tmp
.DS_Store
Thumbs.db

# 环境配置
.env
# 注意：config/config.yaml **是入库文件**（全新 clone 要能直接跑，CI 也依赖它），
# 写在这里的忽略规则对已跟踪文件无效，只会让人误以为"写进去也没关系"。
# 它必须永远保持 webhook_url 为空 —— 真实 webhook 只能走 Secrets / 环境变量。
# tests/test_smoke.py::test_no_real_webhook_committed 会扫描并拦截。
config/config.local.yaml
# 授权 / 加密配置含明文密钥：config/87659999.json 曾把 encryption_key
# 与密文一起提交进公开仓库，现已删除。此规则防止以后再被误提交。
config/87659999*.json

# 个股卡片图片（每次运行重新生成，只走 artifact）
reports/cards/
