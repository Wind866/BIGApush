# ============================================
# A股量化选股系统 - 主配置文件模板
# ============================================
# 使用说明：
# 1. 复制此文件为 config.yaml
# 2. 推荐用环境变量 FEISHU_WEBHOOK 配置机器人（GitHub Actions 用 Secrets）
# 3. config.yaml 是入库文件（clone 即可运行，已跟踪），切勿写入真实密钥

data_dir: data

# 飞书机器人配置
# 留空即可：main.py 会优先读取环境变量 FEISHU_WEBHOOK。
# 如确需本地填写，请用 config/config.local.yaml（已加入 .gitignore），切勿写进本文件。
feishu:
  webhook_url: ""

# 定时任务配置（仅本地运行参考；线上以 .github/workflows/*.yml 的 cron 为准）
# 北京时间：盘中选股 13:13 / 收盘选股 15:43 / 早间新闻 08:43 / 晚间新闻 22:13
schedule:
  time: "15:43"  # 与 .github/workflows/selection.yml 的主档 cron 保持一致

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true
